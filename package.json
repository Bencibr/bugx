  "bin": {
    "bugx": "interfaces/bin/bugx.js"
  },
  "scripts": {
    "postinstall": "node ./scripts/ensure-python.mjs",
    "sync-version": "node ./scripts/sync-version.mjs",
    "prepack": "npm run sync-version && node ./scripts/isolate-npm-readme.mjs prepack",
