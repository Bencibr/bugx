{
  "name": "bugx-cli",
  "version": "${BUGX_VERSION}",
  "description": "Host-neutral adversarial white-box and black-box auditing agent CLI wrapper",
  "type": "module",
  "bin": {
    "bugx": "interfaces/bin/bugx.js"
  },
  "scripts": {
    "postinstall": "node ./scripts/ensure-python.mjs",
    "sync-version": "node ./scripts/sync-version.mjs",
    "prepack": "npm run sync-version && node ./scripts/isolate-npm-readme.mjs prepack",
    "postpack": "node ./scripts/isolate-npm-readme.mjs postpack",
    "test:wrapper": "node ./scripts/test-npm-wrapper.mjs"
  },
  "files": [
    "interfaces/bin/",
    "interfaces/cli/**/*.py",
    "scripts/*.mjs",
    "scripts/runtime.lock.json",
    "core/*.py",
    "core/adapters/**/*.py",
    "core/agent/**/*.py",
    "core/assets/**/*.py",
    "core/audit_packs/**/*.py",
    "core/autonomous_cve/**/*.py",
    "core/cloud_sync/**/*.py",
    "core/contracts/**/*.py",
    "core/coverage/**/*.py",
    "core/dev_harness/*.py",
    "core/fuzzing/**/*.py",
    "core/governance/**/*.py",
    "core/host_acp/**/*.py",
    "core/host_runtime/**/*.py",
    "core/hosts/**/*.py",
    "core/infra/**/*.py",
    "core/launch_phases/**/*.py",
    "core/ledger/**/*.py",
    "core/locales/**/*.py",
    "core/mcp_handlers/**/*.py",
    "core/mcp_runtime_support/**/*.py",
    "core/planning/**/*.py",
    "core/probes/**/*.py",
    "core/project_profiler/**/*.py",
    "core/prompts/**/*.py",
    "core/repair/**/*.py",
    "core/report_engine/**/*.py",
    "core/retrieval/**/*.py",
    "core/rules/**/*.py",
    "core/runtime/**/*.py",
    "core/schemas/**/*.py",
    "core/seed_corpus/**/*.py",
    "core/skills/**/*.py",
    "core/supervisor/**/*.py",
    "core/supervisor_types/**/*.py",
    "core/webui/**/*.py",
    "core/webui/adapters/*.py",
    "core/**/*.json",
    "core/webui/static/",
    "core/**/*.md",
    "core/**/*.txt",
    "core/**/*.yaml",
    "core/**/*.yml",
    "core/**/*.sh",
    "core/**/*.jpg",
    "core/**/*.png",
    "core/**/*.svg",
    "core/**/*.woff",
    "core/**/*.woff2",
    "core/**/*.js",
    "ecosystem/",
    "pyproject.toml",
    "README.md",
    "docs/07_distribution/01_README_NPM.md",
    "LICENSE"
  ],
  "keywords": [
    "agent",
    "ai-agent",
    "ai-code-audit",
    "automated-code-audit",
    "code-audit",
    "code-review",
    "code-review-agent",
    "automated-code-review",
    "vibe-coding",
    "vibe-coding-security",
    "pr-review",
    "pull-request-review",
    "zero-false-positive",
    "poc-generator",
    "security-audit",
    "vulnerability-scanner",
    "vulnerability-mining",
    "sast",
    "static-analysis",
    "mcp",
    "mcp-server",
    "mcp-security",
    "claude-code",
    "codex",
    "opencode",
    "zcode",
    "devsecops",
    "cli"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "BUSL-1.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
