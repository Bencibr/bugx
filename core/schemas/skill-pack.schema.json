{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bugx.local/schemas/skill-pack.schema.json",
  "title": "BugX Skill Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "version",
    "scope",
    "applies_if",
    "stage_pipeline",
    "budgets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "skill_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "issued_at": {
      "type": "string"
    },
    "profile": {
      "enum": [
        "full",
        "lite"
      ]
    },
    "entitlements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_capabilities": {
      "type": "object",
      "additionalProperties": true
    },
    "scope": {
      "enum": [
        "engine",
        "workspace",
        "device"
      ]
    },
    "applies_if": {
      "type": "object",
      "required": [
        "forms",
        "surfaces"
      ],
      "properties": {
        "forms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stage_pipeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "barrier",
          "required"
        ],
        "properties": {
          "stage_id": {
            "type": "string"
          },
          "barrier": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "affinity": {
            "enum": [
              "recon",
              "auth",
              "logic",
              "exploit"
            ]
          },
          "dimension": {
            "description": "证据维度（DOC-234 §5.2）：与 affinity 正交；缺省=未标注，不得默认。",
            "enum": [
              "black-box",
              "white-box",
              "functional"
            ]
          },
          "consumes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "produces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "optional_modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experience_queries": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "budgets": {
      "type": "object",
      "required": [
        "max_l1_checklist_tokens",
        "max_stage_tokens",
        "max_experience_cards",
        "max_experience_tokens"
      ],
      "properties": {
        "max_l1_checklist_tokens": {
          "type": "integer",
          "minimum": 50,
          "maximum": 1000
        },
        "max_stage_tokens": {
          "type": "integer",
          "minimum": 500,
          "maximum": 5000
        },
        "max_experience_cards": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_experience_tokens": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2000
        }
      }
    },
    "required_runtime": {
      "type": "object",
      "additionalProperties": false,
      "description": "挖掘所需运行时能力；tools 默认必需，只有显式 optional 可跳过",
      "properties": {
        "mcp": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "tier": {"enum": ["optional", "hard_for_mcp_auto"]}
                }
              }
            ]
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "stage_ids"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "tier": {"enum": ["required", "optional"]},
              "stage_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "targets": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
