{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bugx.local/schemas/worker-checkpoint.schema.json",
  "title": "BugX Worker Checkpoint",
  "description": "Worker 向当前 Supervisor 提交的单元级发现、覆盖、证据与复盘数据；支持同任务包内最多 5 个亲和单元批量提交。",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkpoint_id"],
  "properties": {
    "checkpoint_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "同一提交重试时必须保持不变的幂等 ID。"
    },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["fingerprint"],
        "properties": {
          "fingerprint": {"type": "string", "minLength": 1, "maxLength": 256},
          "id": {"type": "string", "minLength": 1, "maxLength": 256},
          "case_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "title": {"type": "string", "minLength": 1, "maxLength": 4096},
          "root_cause": {"type": "string", "minLength": 1, "maxLength": 4096},
          "severity": {"type": "string", "maxLength": 32},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {
            "type": "array", "minItems": 1, "maxItems": 50,
            "items": {
              "type": "object", "required": ["path"],
              "properties": {
                "path": {"type": "string", "minLength": 1, "maxLength": 1024},
                "line": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": true
            }
          },
          "reproducible": {"type": "boolean"},
          "reproduction": {"type": "string", "maxLength": 4096}
        },
        "additionalProperties": true
      }
    },
    "coverage": {
      "type": "object",
      "maxProperties": 5,
      "additionalProperties": {
        "enum": [
          "pending", "covered", "blocked", "unverified", "partial",
          "not_applicable", "stale", "removed", "superseded", "corrupted"
        ]
      }
    },
    "evidence": {
      "type": "object",
      "maxProperties": 5,
      "additionalProperties": {
        "type": "object",
        "required": [
          "command", "exit_code", "artifact_path", "artifact_sha256",
          "target_fingerprint", "timestamp", "worker_id", "run_id",
          "round_no", "lease_id", "status"
        ],
        "properties": {
          "command": {"type": "string", "minLength": 1, "maxLength": 8192},
          "exit_code": {"type": "integer"},
          "artifact_path": {"type": "string", "minLength": 1, "maxLength": 1024},
          "artifact_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "target_fingerprint": {"type": "string", "minLength": 1},
          "timestamp": {"type": "number", "exclusiveMinimum": 0},
          "worker_id": {"type": "string", "minLength": 1},
          "run_id": {"type": "string", "minLength": 1},
          "round_no": {"type": "integer", "minimum": 1},
          "lease_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "error", "skipped", "blocked"]},
          "execution_receipt": {
            "type": "object",
            "required": [
              "schema_version", "execution_id", "worker_id", "lease_id",
              "command", "exit_code", "artifact_path", "artifact_sha256", "status"
            ],
            "properties": {
              "schema_version": {"const": 1},
              "execution_id": {"type": "string", "minLength": 1},
              "worker_id": {"type": "string", "minLength": 1},
              "lease_id": {"type": "string", "minLength": 1},
              "command": {"type": "string", "minLength": 1},
              "exit_code": {"type": "integer"},
              "artifact_path": {"type": "string", "minLength": 1},
              "artifact_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
              "status": {"enum": ["passed", "failed", "error", "skipped", "blocked"]}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "signatures": {
      "type": "array",
      "maxItems": 10,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "notes": {
      "type": "object",
      "maxProperties": 5,
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "life_delta": {
      "type": "number",
      "const": 0,
      "description": "必须为 JSON 数字 0；Worker 不得提交生命变化"
    },
    "expected_revision": {"type": "integer", "minimum": 0}
  }
}
