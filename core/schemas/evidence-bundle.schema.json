{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bugx://schemas/evidence-bundle/v1",
  "title": "BugX Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "target_fingerprint", "status", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "target_fingerprint": {"type": "string", "minLength": 1, "maxLength": 256},
    "status": {"enum": ["candidate", "ready_for_confirmation", "rejected", "unavailable"]},
    "artifacts": {
      "type": "array", "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+"},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
        }
      }
    },
    "recipe": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,96}$"},
        "params": {"type": "object", "maxProperties": 20}
      }
    }
  }
}
